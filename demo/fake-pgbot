#!/bin/sh
# A pretend pgbot for demoing pgterm without PostgreSQL or pgbot installed.
# Behavior keys off the DSN pgterm resolves into $DATABASE_URL:
#   mode-healthy → clean bill, mode-warn → warnings, mode-critical → blocked locks.
FIX="$(cd "$(dirname "$0")/../tests/fixtures" && pwd)"
case "$1" in
  --version|-v) echo "pgbot version 0.9.9-demo"; exit 0;;
  indexes) cat "$FIX/indexes_report.json"; exit 0;;
  why) cat "$FIX/why_report.json"; exit 0;;
  ask)
    shift
    [ "${1:-}" = "--yes" ] && shift
    sleep 1
    echo "Demo answer to: $*"
    echo
    echo "The checkout query slowed because public.orders grew +18% and its"
    echo "matching index is no longer used — the planner fell back to"
    echo "sequential scans (0.1/s -> 50/s). See the Why view for the chain."
    exit 0;;
esac
sleep 0.5   # feel like a real check
case "$DATABASE_URL" in
  *mode-warn*)     cat "$FIX/context_warn.json"; exit 1;;
  *mode-critical*) cat "$FIX/context_critical.json"; exit 2;;
  *)               cat "$FIX/context_healthy.json"; exit 0;;
esac
